{
  "extends": "astro/tsconfigs/strict",
  "exclude": ["tmp", "dist", "node_modules"],
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleDetection": "force",
    "types": ["bun"],
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
