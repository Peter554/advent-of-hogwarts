---
import { render } from "astro:content";
import { Image } from "astro:assets";

import Layout from "../../layout.astro";

import utils from "../../utils";

export const getStaticPaths = async () => {
    const stories = await utils.getStories();
    return stories
        .filter((story) => !story.data.locked)
        .map((story) => ({
            params: { date: story.data.date },
            props: { story },
        }));
};

const { story } = Astro.props;

const { Content } = await render(story);
---

<Layout>
    <div class="story-page">
        <a href="/" class="back-link">← Back to Stories</a>
        <h1>{story.data.title}</h1>
        <Image
            src={story.data.image}
            alt={story.data.title}
            class="story-image"
        />
        <div class="story-content">
            <Content />
        </div>
    </div>
</Layout>
