---
import { render } from "astro:content";
import { Image } from "astro:assets";

import Layout from "../../../layout.astro";

import utils from "../../../utils";

export const getStaticPaths = async () => {
    const stories = await utils.getStories();
    return stories
        .filter((story) => !story.data.locked)
        .map((story) => ({
            params: { year: story.data.year, date: story.data.date },
            props: { story },
        }));
};

const { story } = Astro.props;

const { Content } = await render(story);
---

<Layout title={story.data.title}>
    <div class="reading-progress" aria-hidden="true"></div>
    <div class="story-page">
        <a href={`/${story.data.year}/`} class="back-link"
            >← Back to {story.data.year}</a
        >
        <h1>{story.data.title}</h1>
        <Image
            src={story.data.image}
            alt={story.data.title}
            class="story-image"
        />
        <div class="story-content">
            <Content />
        </div>
    </div>
</Layout>
