---
import Layout from "../layout.astro";

import utils from "../utils";

const stories = await utils.getStories();
---

<Layout
    >{
        stories.map((story) => {
            return (
                <p>
                    <a href={`/stories/${story.data.date}`}>
                        {story.data.date}: {story.data.title}
                    </a>
                </p>
            );
        })
    }</Layout
>
