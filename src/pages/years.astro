---
import Layout from "../layout.astro";
import utils from "../utils";

const years = await Promise.all(
    (await utils.getYears()).map(async (year) => {
        const stories = await utils.getStories(year);
        return {
            year,
            total: stories.length,
            unlocked: stories.filter((story) => !story.data.locked).length,
        };
    }),
);
---

<Layout title="All years">
    <h2 class="year-heading">All years</h2>
    <div class="story-grid">
        {years.map(({ year, total, unlocked }) => (
            <div class="story-card">
                <a href={`/${year}/`}>
                    <h2 class="story-title">{year}</h2>
                </a>
            </div>
        ))}
    </div>
</Layout>
